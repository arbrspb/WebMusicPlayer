  "training_min_macro_f1": 0.65,
  "training_min_accepted_precision": 0.9,
  "training_min_coverage": 0.45,
  "validation_size": 0.2,
  "random_state": 42,
  "features": {
    "mfcc": true,
    "chroma": true,
    "spectral_contrast": true,
    "zcr": true,
    "tonnetz": false,
    "spectral_centroid": true,
    "spectral_bandwidth": true,
    "spectral_rolloff": true,
    "rms": true,
    "onset_strength": true,
    "tempo": true,
    "tempogram": false,
    "delta_mfcc": true,
    "delta2_mfcc": true,
    "spectral_flatness": true,
    "pitch": false,
    "silence_ratio": true,
    "energy_entropy": true,
    "spectral_skewness": false,
    "harmonic_ratio": false,
    "mfcc_std": true,
    "energy_ratio": true,
    "spectral_stats": false
